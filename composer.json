{
  "name": "drupal/pantheon_advanced_page_cache",
  "description": "Pantheon Advanced Page Cache",
  "license": "MIT",
  "type": "drupal-module",
  "require": {
    "php": ">=8.1",
    "symfony/http-foundation": "^6 || ^7",
    "guzzlehttp/psr7": "2.4.5"
  },
  "require-dev": {
    "consolidation/robo": "^5.1",
    "drupal/coder": "@stable",
    "drupal/drupal-extension": "@stable",
    "phpunit/phpunit": "@stable",
    "psy/psysh": "@stable",
    "squizlabs/php_codesniffer": "@stable"
  },
  "scripts": {
    "code:fix": [
      "vendor/bin/phpcs --config-set installed_paths vendor/drupal/coder/coder_sniffer",
      "vendor/bin/phpcbf . --ignore=vendor src"
    ],
    "code:lint": [
      "vendor/bin/phpcs --config-set installed_paths vendor/drupal/coder/coder_sniffer",
      "vendor/bin/phpcs --ignore=vendor . "
    ],
    "test": [
      "phpunit tests --colors=always"
    ],
    "pre-commit": [
      "composer validate --strict",
      "@code:fix",
      "@code:lint",
      "@code:test"
    ]
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "suggest": {
    "kint-php/kint": "@stable"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "PantheonSystems\\CDNBehatHelpers\\": "tests/behat/helper_classes/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}

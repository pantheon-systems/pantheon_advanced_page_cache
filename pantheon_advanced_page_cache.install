<?php

/**
 * @file
 * Update functions for the Pantheon Advanced Page Cache module.
 */

/**
 * Set override_list_tags to TRUE for backwards compatibility.
 *
 * We recommend manually changing to FALSE for more consistent clearing. See
 * README.
 */
function pantheon_advanced_page_cache_update_8001() {
  \Drupal::configFactory()
    ->getEditable('pantheon_advanced_page_cache.settings')
    ->set('override_list_tags', TRUE)
    ->save();
}

/**
 * Implements hook_requirements().
 */
function pantheon_advanced_page_cache_requirements($phase) {
  $requirements = [];
  if ($phase === 'runtime') {
    if (\Drupal::moduleHandler()->moduleExists('big_pipe')) {
      $requirements['pantheon_advanced_page_cache_big_pipe'] = [
        'title' => t('Pantheon Advanced Page Cache: Big Pipe incompatibility'),
        'value' => t('Big Pipe module is enabled'),
        'severity' => REQUIREMENT_ERROR,
        'description' => t('Big Pipe provides no benefit on Pantheon and the module is <strong>incompatible</strong> with Pantheon Advanced Page Cache. It can cause fatal errors (such as 504 Gateway Timeout) and site breakage. <strong>Disable or uninstall Big Pipe immediately.</strong>'),
      ];
    }
  }
  return $requirements;
}

/**
 * Uninstall big_pipe module if it's enabled.
 */
function pantheon_advanced_page_cache_update_8002() {
  if (\Drupal::moduleHandler()->moduleExists('big_pipe')) {
    \Drupal::service('module_installer')->uninstall(['big_pipe']);
    \Drupal::messenger()->addWarning(t('The big_pipe module has been uninstalled as it is incompatible with Pantheon Advanced Page Cache.'));
  }
}

/**
 * Implements hook_install().
 */
function pantheon_advanced_page_cache_install() {
  // Check if big_pipe module is enabled and uninstall it.
  if (\Drupal::moduleHandler()->moduleExists('big_pipe')) {
    \Drupal::service('module_installer')->uninstall(['big_pipe']);
    \Drupal::messenger()->addWarning(t('The big_pipe module has been uninstalled as it is incompatible with Pantheon Advanced Page Cache.'));
  }
}
